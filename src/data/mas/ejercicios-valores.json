        { "id": "ar3", "partes": ["", " Solidarität"], "respuesta": "die", "distractores": ["der", "das"], "pista": "-ität → siempre femenino." },
        { "id": "ar4", "partes": ["", " Zusammenleben"], "respuesta": "das", "distractores": ["der", "die"], "pista": "Infinitivo usado como sustantivo → neutro." },
        { "id": "ar5", "partes": ["", " Wert"], "respuesta": "der", "distractores": ["die", "das"], "pista": "Sin sufijo hay que aprenderlo: der Wert, die Werte." },
        { "id": "ar6", "partes": ["", " Vorurteil"], "respuesta": "das", "distractores": ["der", "die"], "pista": "das Urteil → das Vorurteil: el prefijo no cambia el género." },
        { "id": "ar7", "partes": ["", " Erziehung"], "respuesta": "die", "distractores": ["der", "das"], "pista": "-ung → siempre femenino." },
