        { "id": "ar9", "partes": ["", " Toleranz"], "respuesta": "die", "distractores": ["der", "das"], "pista": "-anz → femenino." },
        { "id": "ar10", "partes": ["", " Menschenrecht"], "respuesta": "das", "distractores": ["der", "die"], "pista": "Compuesto: manda la última palabra (das Recht)." },
        { "id": "ar11", "partes": ["", " Meinungsfreiheit"], "respuesta": "die", "distractores": ["der", "das"], "pista": "Compuesto: manda la última palabra (die Freiheit)." },
        { "id": "ar12", "partes": ["", " Frieden"], "respuesta": "der", "distractores": ["die", "das"], "pista": "Sin sufijo: der Frieden (Sg.)." }
