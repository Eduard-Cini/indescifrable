        { "id": "fo8", "partes": null, "pregunta": "der Schlüssel für die Haustür", "respuesta": "der Haustürschlüssel", "distractores": ["die Haustürschlüssel", "der Schlüsselhaustür", "das Haustürschlüssel"], "pista": "Se pueden encadenar tres palabras: la última sigue mandando." }
