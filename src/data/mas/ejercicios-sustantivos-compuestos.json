        { "id": "un1", "partes": null, "pregunta": "das Glück + das Gefühl", "respuesta": "das Glücksgefühl", "distractores": ["das Glückgefühl", "das Glückesgefühl", "das Glückengefühl"], "pista": "Con -s-." },
        { "id": "un2", "partes": null, "pregunta": "das Auto + der Schlüssel", "respuesta": "der Autoschlüssel", "distractores": ["der Autosschlüssel", "der Autosschlussel", "der Autoesschlüssel"], "pista": "Sin unión." },
