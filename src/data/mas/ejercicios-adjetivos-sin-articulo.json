      "ejercicios": [
        { "id": "ct1", "partes": ["Ich trinke gern ", " Tee."], "respuesta": "kalten", "distractores": ["kalter", "kalte"], "pista": "Sin artículo, masculino acusativo → -en (como den)." },
        { "id": "ct2", "partes": ["Der ", " Tee schmeckt gut."], "respuesta": "kalte", "distractores": ["kalter", "kalten"], "pista": "Con der, el artículo ya lleva la marca → -e." },
        { "id": "ct3", "partes": ["Das ist ", " Wasser."], "respuesta": "frisches", "distractores": ["frische", "frischen"], "pista": "Sin artículo, neutro nominativo → -es (como das)." },
        { "id": "ct4", "partes": ["Das ", " Wasser ist sehr gut."], "respuesta": "frische", "distractores": ["frisches", "frischen"], "pista": "Con das → -e." },
