        { "id": "te1", "partes": ["Ferdy ist ", " im Krankenhaus und arbeitet oft nachts."], "respuesta": "Angestellter", "distractores": ["Angestellte", "Angestellten", "Angestelltes"], "pista": "Sin artículo, masculino nominativo → -er, como der." },
